{
  "name": "ilw-ui",
  "version": "0.2.0",
  "private": true,
  "description": "Accessible Svelte components that look and behave like the Illinois Web Toolkit",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "exports": {
    "./core": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./svelte": {
      "types": "./src/svelte/index.ts",
      "svelte": "./src/svelte/index.ts",
      "default": "./src/svelte/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./styles/*": "./src/styles/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic"
  },
  "peerDependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/svelte-table": "9.3.1",
