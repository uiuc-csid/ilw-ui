{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    // For tests/unit/react-ssr.test.ts, which imports both adapters.
    "jsx": "react-jsx"
  },
  "include": ["src", "stories", "tests", ".storybook", "*.ts", "*.js"],
  // The React paths: tsconfig.react.json checks them (tsc, in `pnpm check`).
  "exclude": ["src/react", "stories/react"]
}
