{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  // pnpm refuses packages younger than its minimumReleaseAge (default 1440
  // minutes), so Renovate waits as long or its lockfile update would fail.
  // Global, not npm-only, so the Playwright image and packages stay in step.
  minimumReleaseAge: '1 day',
  packageRules: [
    {
      // The CI image's browsers only work with the same Playwright version
      // pnpm installs (tests/unit/playwright-container.test.ts), so the image
      // and the npm packages move in one PR.
      groupName: 'Playwright',
      matchPackageNames: ['playwright', '@playwright/test', 'mcr.microsoft.com/playwright'],
      separateMajorMinor: false,
    },
    {
      // Tags look like v1.64.1-noble; keep the Ubuntu suffix fixed.
      matchDatasources: ['docker'],
      matchPackageNames: ['mcr.microsoft.com/playwright'],
      versioning: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<compatibility>[a-z]+)$',
    },
    // Library families are pinned exactly and move in lockstep (AGENTS.md).
    { groupName: 'Storybook', matchPackageNames: ['storybook', '@storybook/*'], separateMajorMinor: false },
    { groupName: 'Vitest', matchPackageNames: ['vitest', '@vitest/*'], separateMajorMinor: false },
    { groupName: 'Zag', matchPackageNames: ['@zag-js/*'], separateMajorMinor: false },
    { groupName: 'TanStack Table', matchPackageNames: ['@tanstack/*'], separateMajorMinor: false },
    { groupName: 'React', matchPackageNames: ['react', 'react-dom', '@types/react', '@types/react-dom'], separateMajorMinor: false },
    {
      // eslint-plugin-jsx-a11y 6.10.2 supports ESLint up to 9 (its peer
      // range); move to 10 once it does.
      matchPackageNames: ['eslint'],
      allowedVersions: '<10',
    },
    {
      // The framework adapters are optional peers, exact or caret like their
      // devDependencies. Renovate widens peer ranges by default; bump them
      // instead, in the same PR as the devDependency
      // (tests/unit/peers.test.ts).
      matchDepTypes: ['peerDependencies'],
      rangeStrategy: 'bump',
    },
    {
      // The framework peers are a ^major.minor floor, not a pin: bump writes
      // ^19.3.1 on every patch and replace/widen write ^20.0.0, all of which
      // fail tests/unit/peers.test.ts. Renovate updates only the
      // devDependency; raise the floor by hand when a major needs it.
      matchDepTypes: ['peerDependencies'],
      matchPackageNames: ['react', 'react-dom', 'svelte'],
      enabled: false,
    },
  ],
}
